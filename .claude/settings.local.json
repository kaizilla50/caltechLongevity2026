{
  "permissions": {
    "allow": [
      "PowerShell(npm install --save-dev vitest 2>&1)",
      "PowerShell(npm test 2>&1)",
      "PowerShell(npm test -- --reporter=verbose 2>&1)",
      "Skill(claude-api)",
      "Skill(claude-api:*)",
      "PowerShell(npm install @anthropic-ai/sdk 2>&1)",
      "PowerShell(if \\(Test-Path '.env.local'\\) { Write-Output 'exists'; \\(Get-Content '.env.local' | Measure-Object\\).Count } else { Write-Output 'missing' })",
      "PowerShell(if \\($env:ANTHROPIC_API_KEY\\) { Write-Output \\(\"set, length=\" + $env:ANTHROPIC_API_KEY.Length\\) } else { Write-Output \"not set\" })",
      "PowerShell(npm run dev 2>&1)",
      "PowerShell(curl.exe -s -X POST http://localhost:3000/api/checkin -H \"Content-Type: application/json; charset=utf-8\" --data-binary \"@.tmp-checkin-body.json\" --max-time 120)",
      "PowerShell(curl.exe -s -o $null -w \"status=%{http_code} time=%{time_total}s size=%{size_download}`n\" http://localhost:3000/ --max-time 60)",
      "PowerShell(curl.exe -s -o $null -w \"page_status=%{http_code} time=%{time_total}s`n\" http://localhost:3000/ --max-time 60)",
      "Bash(npx tsc *)",
      "Bash(npx next *)"
    ]
  }
}
